{
	"name": "Humble New Tab Page",
	"short_name": "HNTP",
	"version": "1.26.2",
	"minimum_chrome_version": "104",
	"manifest_version": 3,
	"description": "Redesigned new tab page featuring your bookmarks, apps, most visited, and recently closed in a custom layout.",
	"icons": {
		"128": "icons/icon_128.png",
		"48": "icons/icon_48.png",
		"16": "icons/icon_16.png"
	},
	"permissions": [
		"bookmarks",
		"favicon",
		"topSites",
		"tabs",
		"fontSettings",
		"sessions"
	],
	"optional_host_permissions": [
		"file:///"
	],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_ui": {
		"page": "newtab.html?options",
		"open_in_tab": true
	},
	"content_security_policy": {
       "extension_pages": "default-src 'self'; frame-src 'self' http: https:;"
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "humble_new_tab@local"
      }
   }
}
